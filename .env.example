# GitHub App credentials, from the app's settings page.
GITHUB_APP_ID=123456
GITHUB_WEBHOOK_SECRET=generate-a-long-random-string

# PEM private key. Literal \n escapes are accepted, so this can stay on one line.
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----\n"

# Model credentials. Omit if you have run `ant auth login` — the SDK resolves
# ANTHROPIC_API_KEY, then ANTHROPIC_AUTH_TOKEN, then an auth profile on disk.
ANTHROPIC_API_KEY=

# Let a blocking verdict submit REQUEST_CHANGES instead of a plain comment.
# Off by default: blocking a contributor's PR on a model's reading is opt-in.
ALLOW_REQUEST_CHANGES=false

PORT=3000
